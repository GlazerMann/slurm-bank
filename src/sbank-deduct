# Requires 'sacctmgr'

. "${SLURMBANK_DIR}/sbank-bank-common"

usage()
{
	echo "usage: sbank deduct -c CLUSTER -a ACCOUNT -t TIME [-r TRES]"
	echo
	echo "       TRES may be 'cpu' (default) or 'gres/gpu'"
	echo
}

parse_args() {
	# parse options
	FLAGS "$@" || exit $?
	eval set -- "${FLAGS_ARGV}"
}

cmd_default()
{
	cmd_deduct "$@"
}

cmd_deduct()
{
	local EXPECTED_LIMIT
	local NEW_LIMIT
	local MINUTES
	local WITHDRAWABLE

	debug "define some variables"
	DEFINE_string 'account' 'null' 'specify a slurm account' 'a'
	DEFINE_string 'cluster' 'null' 'specify a cluster' 'c'
	DEFINE_string 'time' '0' 'specify time in whole hours' 't'
	DEFINE_string 'tres' 'cpu' 'resource to debit: cpu or gres/gpu' 'r'

	FLAGS_PARENT="sbank deduct"

	debug "parse command line"
	parse_args "$@"

	[ "${FLAGS_cluster}" = 'null' ] && die "${FLAGS_cluster}" "is not a cluster, no cluster specified"
	[ "${FLAGS_account}" = 'null' ] && die "${FLAGS_account}" "is not an account, no account specified"

	case "${FLAGS_tres}" in
		cpu|gres/gpu)
			;;
		*)
			die "unsupported TRES '${FLAGS_tres}'; use 'cpu' or 'gres/gpu'"
			;;
	esac

	sbank_parse_hours "${FLAGS_time}"
	MINUTES=${SBANK_MINUTES}

	sbank_acquire_lock
	sbank_read_account_record

	if [ "${FLAGS_tres}" = "cpu" ]; then
		sbank_parse_cpu_limit "${SBANK_CPU_FIELD}"
		[ "${SBANK_CPU_LIMIT_STATE}" = "set" ] ||
			die "CPU limit is unset; refusing to deduct from an account with no account-level CPU limit"
		EXPECTED_LIMIT=${SBANK_CPU_LIMIT}
		[ "${EXPECTED_LIMIT}" -ge "${MINUTES}" ] ||
			die "cannot deduct ${FLAGS_time} CPU-hours; configured allocation is only ${EXPECTED_LIMIT} CPU-minutes"

		NEW_LIMIT=$((EXPECTED_LIMIT - MINUTES))
		sbank_verify_cpu_limit_unchanged "${EXPECTED_LIMIT}"
		debug "Updating CPU account limit: ${EXPECTED_LIMIT} - ${MINUTES} = ${NEW_LIMIT} minutes"
		$SACCTMGR -i modify account "account=${FLAGS_account}" \
			set "GrpCPUMins=${NEW_LIMIT}" where "cluster=${FLAGS_cluster}" ||
			die "failed to update CPU limit for account ${FLAGS_account}"
		sbank_verify_cpu_limit_written "${NEW_LIMIT}"
	else
		sbank_require_non_root_gpu_account
		sbank_require_cluster_gpu_tres
		sbank_require_gpu_enforcement
		sbank_read_gpu_share_state

		[ "${SBANK_GPU_LIMIT_STATE}" = "set" ] ||
			die "no account-level gres/gpu limit is set; initialize a finite GPU-hour bank with sbank deposit first"
		EXPECTED_LIMIT=${SBANK_GPU_LIMIT}

		if [ "${EXPECTED_LIMIT}" -le "${SBANK_GPU_COMMITTED}" ]; then
			WITHDRAWABLE=0
		else
			WITHDRAWABLE=$((EXPECTED_LIMIT - SBANK_GPU_COMMITTED))
		fi

		[ "${MINUTES}" -le "${WITHDRAWABLE}" ] ||
			die "cannot deduct ${FLAGS_time} GPU-hours; only ${WITHDRAWABLE} GPU-minutes are withdrawable after effective usage and running-job commitments"

		# Refresh the controller usage immediately before lowering the limit.
		# This catches jobs that started after the first balance check.
		sbank_read_account_record
		sbank_read_gpu_share_state
		[ "${SBANK_GPU_LIMIT_STATE}" = "set" ] && [ "${SBANK_GPU_LIMIT}" = "${EXPECTED_LIMIT}" ] ||
			die "gres/gpu limit changed concurrently; no deduction was made"
		if [ "${EXPECTED_LIMIT}" -le "${SBANK_GPU_COMMITTED}" ]; then
			WITHDRAWABLE=0
		else
			WITHDRAWABLE=$((EXPECTED_LIMIT - SBANK_GPU_COMMITTED))
		fi
		[ "${MINUTES}" -le "${WITHDRAWABLE}" ] ||
			die "cannot deduct ${FLAGS_time} GPU-hours after refreshing running commitments; only ${WITHDRAWABLE} GPU-minutes are withdrawable"

		NEW_LIMIT=$((EXPECTED_LIMIT - MINUTES))
		debug "Updating gres/gpu allocation: ${EXPECTED_LIMIT} - ${MINUTES} = ${NEW_LIMIT} GPU-minutes"
		$SACCTMGR -i modify account "account=${FLAGS_account}" \
			set "GrpTRESMins=gres/gpu=${NEW_LIMIT}" where "cluster=${FLAGS_cluster}" ||
			die "failed to update gres/gpu limit for account ${FLAGS_account}"
		sbank_verify_gpu_limit_written "${NEW_LIMIT}"
	fi
}

cmd_help()
{
	usage
}
